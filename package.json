{
  "name": "staff-lens",
  "private": true,
  "version": "0.1.0",
  "description": "StaffLens \u2014 read, explain, play and convert standard notation to guitar tab, entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node tools/fetch-models.mjs",
    "predev": "node tools/copy-ocr.mjs",
    "prebuild": "node tools/copy-ocr.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.9.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
